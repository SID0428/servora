{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/index" },
    { "source": "/company", "destination": "/company-login" },
    { "source": "/franchise", "destination": "/franchise-login" },
    { "source": "/technician", "destination": "/technician-login" },
    { "source": "/admin", "destination": "/admin-login" },
    { "source": "/technician-dashboard", "destination": "/ops-dashboard" },
    { "source": "/franchise-dashboard", "destination": "/ops-dashboard" },
    { "source": "/company-dashboard", "destination": "/ops-dashboard" },
    { "source": "/admin-dashboard", "destination": "/ops-dashboard" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
