# Servora Environment Configuration

# Aiven MySQL Connection URL format:
# mysql+pymysql://<AVN_USER>:<AVN_PASSWORD>@<AVN_HOST>:<AVN_PORT>/<AVN_DB_NAME>?ssl_mode=REQUIRED
# Example:
# DATABASE_URL=mysql+pymysql://avnadmin:AVNS_example123@mysql-servora-my-org.aivencloud.com:12345/defaultdb?ssl_mode=REQUIRED

# Leave blank or omit for local offline development (will automatically use local SQLite servora.db):
DATABASE_URL=sqlite:///./servora.db

# Port for backend server
PORT=8000
