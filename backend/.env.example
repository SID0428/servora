# ServSure Environment Configuration
# File: backend/.env.example

# Aiven MySQL Connection URL format:
# mysql+pymysql://<AVN_USER>:<AVN_PASSWORD>@<AVN_HOST>:<AVN_PORT>/<AVN_DB_NAME>?ssl_mode=REQUIRED
# Example:
# DATABASE_URL=mysql+pymysql://avnadmin:AVNS_example123@mysql-servsure-my-org.aivencloud.com:12345/defaultdb?ssl_mode=REQUIRED

# Leave blank or omit for local offline development (will automatically use local SQLite servora.db):
DATABASE_URL=sqlite:///./servora.db

# Port for backend server
PORT=8000

# CORS Allowed Origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,https://servsure.vercel.app,https://servora-frontend-xi.vercel.app

# Public Frontend Base URL (used to generate company, franchise, and technician setup invitation links)
FRONTEND_BASE_URL=https://servsure.vercel.app

# Google OAuth (Google Identity Services Client ID)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Brevo (Sendinblue) Transactional Email Service
# Required for sending onboarding invitation links and 6-digit email OTPs
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-brevo-sender@domain.com
BREVO_SENDER_NAME=ServSure

# Seed Account Demo Password (optional; default: password123)
DEMO_PASSWORD=password123

# Render Keep-Alive Background Worker Settings
# Seconds between self-pings (Render free-tier idle limit is 900s / 15m; 840s = 14m)
KEEP_ALIVE_INTERVAL_SECONDS=840
PING_URL=https://servora-3v6b.onrender.com
RENDER_EXTERNAL_URL=https://servora-3v6b.onrender.com
